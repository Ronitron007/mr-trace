 # --- records --------------------------------------------------------------------
 
+def _title(text: str | None) -> str | None:
+    """First non-empty line of the task text, at most 120 chars (mr-trace shows it as the job name)."""
+    for line in (text or "").splitlines():
+        line = line.strip()
+        if line:
+            return line[:120]
+    return None
+
+
+def _caller() -> str | None:
+    """Who asked mr to run: $MR_CALLER (e.g. 'goosebump', 'outbox'), else the parent process name."""
+    v = os.environ.get("MR_CALLER")
+    if v:
+        return v[:60]
+    try:
+        with open(f"/proc/{os.getppid()}/comm", encoding="utf-8") as f:
+            return f.read().strip()[:60] or None
+    except OSError:
+        return None
+
+
